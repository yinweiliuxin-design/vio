+      SV_BAT_OFF_HOLD_MS=3000,SV_BAT_FLASH_MIN_MV=3500};
+typedef struct {
+    bool valid,warn,shutdown;
+    uint32_t filtered_mv_x8,generation,low_since;bool low_tracking;
+} sv_battery;
+void sv_battery_init(sv_battery *);
