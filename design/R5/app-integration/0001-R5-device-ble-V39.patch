+<!doctype html>
+<html lang="zh-CN">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
+<meta name="theme-color" content="#f7f7f9">
+<title>R5 设备联调</title>
+<link rel="icon" href="favicon.svg">
+<style>
+  :root{--bg:#f7f7f9;--card:#fff;--ink:#1d1d1f;--quiet:#6e6e73;--line:#e3e3e8;--accent:#c8102e;--good:#1a7f37;--bad:#b42318}
+  *{box-sizing:border-box}
+  body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.5 system-ui,-apple-system,"PingFang SC","Microsoft YaHei",sans-serif}
+  main{max-width:560px;margin:0 auto;padding:16px 16px calc(32px + env(safe-area-inset-bottom))}
+  h1{font-size:22px;margin:8px 0 4px}
+  .sub{color:var(--quiet);margin:0 0 16px;font-size:13px}
+  section{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:14px 16px;margin:0 0 12px}
+  h2{font-size:15px;margin:0 0 10px}
+  .row{display:flex;justify-content:space-between;gap:12px;padding:4px 0;font-size:14px}
+  .row span:first-child{color:var(--quiet)}
+  .ok{color:var(--good)}.no{color:var(--bad)}
+  button{font:inherit;min-height:44px;border-radius:10px;border:1px solid var(--line);background:#fff;padding:0 14px;cursor:pointer}
+  button.primary{background:var(--accent);border-color:var(--accent);color:#fff}
+  button[aria-pressed="true"]{border-color:var(--accent);color:var(--accent);font-weight:600}
+  button:disabled{opacity:.45;cursor:not-allowed}
+  .buttons{display:flex;flex-wrap:wrap;gap:8px}
+  label.slider{display:grid;grid-template-columns:5em 1fr 3em;align-items:center;gap:8px;margin:6px 0;font-size:14px}
+  input[type=range]{width:100%;accent-color:var(--accent)}
+  output{text-align:right;font-variant-numeric:tabular-nums}
+  #log{font:12px/1.5 ui-monospace,Menlo,Consolas,monospace;white-space:pre-wrap;max-height:220px;overflow:auto;background:#fafafa;border-radius:8px;padding:8px;margin:0}
+  table{width:100%;border-collapse:collapse;font-size:13px}
+  td{border-top:1px solid var(--line);padding:6px 4px;vertical-align:top}
+  td:nth-child(2){white-space:nowrap}
+  .note{font-size:13px;color:var(--quiet);margin:8px 0 0}
+</style>
+</head>
+<body>
+<main>
+  <h1>R5 设备联调</h1>
+  <p class="sub">用来验证 Silvio App 和 R5 实体机（或刷了台架固件的 ESP32-S3 开发板）之间的蓝牙控制。请用安卓手机的 Chrome 打开。</p>
+
+  <section aria-labelledby="env-h">
+    <h2 id="env-h">1 环境检查</h2>
+    <div id="env"></div>
+  </section>
+
+  <section aria-labelledby="dev-h">
+    <h2 id="dev-h">2 连接设备</h2>
+    <div class="buttons"><button id="connect" class="primary">搜索并连接</button><button id="disconnect" disabled>断开</button><button id="refresh" disabled>重新读取</button></div>
+    <div class="row"><span>设备</span><span id="name">未连接</span></div>
+    <div class="row"><span>电量</span><span id="battery">—</span></div>
+    <div class="row"><span>最近往返时间</span><span id="rtt">—</span></div>
+  </section>
+
+  <section aria-labelledby="out-h">
+    <h2 id="out-h">3 输出切换</h2>
+    <div class="buttons" id="outputs"></div>
+  </section>
+
+  <section aria-labelledby="par-h">
+    <h2 id="par-h">4 参数</h2>
+    <div id="sliders"></div>
+    <p class="note">在实体机上转旋钮或在台架控制台输入 <code>vol 40</code>，这里的数值应在 1 秒内跟着变。</p>
+  </section>
+
+  <section aria-labelledby="auto-h">
+    <h2 id="auto-h">5 自动联调</h2>
+    <div class="buttons"><button id="run" disabled>开始自动联调</button><button id="copy" disabled>复制联调记录</button></div>
+    <table id="results" aria-live="polite"></table>
+  </section>
+
+  <section aria-labelledby="log-h">
+    <h2 id="log-h">日志</h2>
+    <pre id="log"></pre>
+  </section>
+</main>
+<script src="r5-device.js"></script>
+<script src="r5-device-page.js"></script>
+</body>
+</html>
diff --git a/web-workspace/apps/mainland/dist/r5-device.js b/web-workspace/apps/mainland/dist/r5-device.js
new file mode 100644
index 0000000..c6b86ff
--- /dev/null
+++ b/web-workspace/apps/mainland/dist/r5-device.js
@@ -0,0 +1,195 @@
+/* SmartVio R5 control link over BLE (Web Bluetooth or an injected native transport).
+ * Protocol = R5 bench firmware GATT (vio/design/R5/verify/firmware/main/ble.c, draft v0.1):
+ *   Battery Service 0x180F / Battery Level 0x2A19   read, notify   uint8 0..100
+ *   R5 service 5a0e5000-7e4b-4c1e-9c2a-52355f425231
+ *     5a0e5001 output mode  read, write, notify  uint8: 0 hp, 1 spk, 2 bt, 3 spk+bt
+ *     5a0e5002 parameters   read, write, notify  4 x uint8 0..100: vol, tone, fx, mix
+ * Events passed to subscribe(): connected, disconnected, written (local write accepted),
+ * output / params / battery (device notification), roundtrip (echo of our own write), error.
+ * The bench firmware advertises as "SmartVio-R5-bench" and only lists 0x180F, so the
+ * R5 service must be requested through optionalServices. */
+(function(root,factory){
+  'use strict';
+  const api=factory();
+  if(typeof module==='object'&&module.exports)module.exports=api;
+  else root.SVR5Device=api;
+})(typeof globalThis==='object'?globalThis:this,function(){
+  'use strict';
+  const R5_SERVICE='5a0e5000-7e4b-4c1e-9c2a-52355f425231';
+  const R5_OUTPUT='5a0e5001-7e4b-4c1e-9c2a-52355f425231';
+  const R5_PARAMS='5a0e5002-7e4b-4c1e-9c2a-52355f425231';
+  const BATTERY_SERVICE=0x180f,BATTERY_LEVEL=0x2a19;
+  const NAME_PREFIX='SmartVio-R5';
+  const OUTPUT_MODES=Object.freeze([
+    Object.freeze({code:0,key:'hp',label:'耳机'}),
+    Object.freeze({code:1,key:'spk',label:'外放'}),
+    Object.freeze({code:2,key:'bt',label:'蓝牙耳机'}),
+    Object.freeze({code:3,key:'spk+bt',label:'外放 + 蓝牙'})
+  ]);
+  const PARAM_KEYS=Object.freeze(['vol','tone','fx','mix']);
+
+  class R5DeviceError extends Error{
+    constructor(code,message,cause){super(message);this.name='R5DeviceError';this.code=code;this.causeName=cause?.name||null;}
+  }
+  const fail=(code,message,cause)=>new R5DeviceError(code,message,cause);
+
+  function bytesOf(value){
+    if(value instanceof Uint8Array)return value;
+    if(value&&value.buffer instanceof ArrayBuffer)return new Uint8Array(value.buffer,value.byteOffset||0,value.byteLength);
+    if(value instanceof ArrayBuffer)return new Uint8Array(value);
+    throw fail('INVALID_RESPONSE','设备返回的数据格式无法识别');
+  }
+  function decodeBattery(value){
+    const b=bytesOf(value);
+    if(b.length!==1||b[0]>100)throw fail('INVALID_RESPONSE','电量数据应为 1 字节 0–100');
+    return b[0];
+  }
+  function decodeOutput(value){
+    const b=bytesOf(value);
+    if(b.length!==1)throw fail('INVALID_RESPONSE','输出模式数据应为 1 字节');
+    const mode=OUTPUT_MODES.find(m=>m.code===b[0]);
+    if(!mode)throw fail('INVALID_RESPONSE','未知的输出模式编码：'+b[0]);
+    return mode.code;
+  }
+  function encodeOutput(code){
+    if(!OUTPUT_MODES.some(m=>m.code===code))throw fail('INVALID_VALUE','输出模式只能是 0–3');
+    return Uint8Array.of(code);
+  }
+  function decodeParams(value){
+    const b=bytesOf(value);
+    if(b.length!==4)throw fail('INVALID_RESPONSE','参数数据应为 4 字节');
+    for(const v of b)if(v>100)throw fail('INVALID_RESPONSE','参数超出 0–100');
+    return {vol:b[0],tone:b[1],fx:b[2],mix:b[3]};
+  }
+  function encodeParams(params){
+    const out=new Uint8Array(4);
+    PARAM_KEYS.forEach((key,i)=>{
+      const v=params?.[key];
+      if(!Number.isInteger(v)||v<0||v>100)throw fail('INVALID_VALUE','参数 '+key+' 必须是 0–100 的整数');
+      out[i]=v;
+    });
+    return out;
+  }
+  function detectEnvironment(env){
+    const nav=env?.navigator||{},ua=String(nav.userAgent||'');
+    const androidWebView=/; wv\)/.test(ua)||/\bVersion\/[\d.]+ Chrome\/[\d.]+ Mobile Safari/.test(ua)&&/Android/.test(ua);
+    return Object.freeze({
+      secureContext:env?.isSecureContext===true,
+      webBluetooth:env?.isSecureContext===true&&typeof nav.bluetooth?.requestDevice==='function',
+      androidWebView,
+      iOS:/iPhone|iPad|iPod/.test(ua),
+      nativeTransport:typeof env?.SilvioNativeBle?.requestDevice==='function'
+    });
+  }
+
+  const same=(a,b)=>a.length===b.length&&a.every((v,i)=>v===b[i]);
+
+  /* One GATT operation at a time: Chrome rejects overlapping operations. */
+  function createQueue(){
+    let tail=Promise.resolve();
+    return task=>{const run=tail.then(task,task);tail=run.catch(()=>{});return run;};
+  }
+
+  function createClient(env,options={}){
+    const nav=env?.navigator||{};
+    const bluetooth=options.bluetooth||env?.SilvioNativeBle||nav.bluetooth;
+    const now=typeof options.now==='function'?options.now:()=>Date.now();
+    const listeners=new Set(),queue=createQueue();
+    const state={connected:false,deviceName:null,battery:null,output:null,params:null,lastRoundTripMs:null};
+    let device=null,chars={},pendingEcho=null,disconnectHandler=null;
+
+    const snapshot=()=>({...state,params:state.params?{...state.params}:null});
+    const emit=type=>{const s=snapshot();for(const fn of [...listeners])try{fn(type,s);}catch(_){}};
+    function onNotify(kind){
+      return event=>{
+        try{
+          const value=event?.target?.value;
+          if(kind==='battery')state.battery=decodeBattery(value);
+          else if(kind==='output')state.output=decodeOutput(value);
+          else state.params=decodeParams(value);
+          /* The firmware re-notifies output and params after any change, so an echo only counts
+           * once our write has completed and the notified bytes equal what we wrote. */
+          const echoed=pendingEcho&&pendingEcho.kind===kind&&pendingEcho.armed&&same(bytesOf(value),pendingEcho.bytes);
+          if(echoed){state.lastRoundTripMs=now()-pendingEcho.start;pendingEcho=null;}
+          emit(kind);
+          if(echoed)emit('roundtrip');
+        }catch(error){emit('error');}
+      };
+    }
+    async function subscribe(characteristic,kind){
+      if(!characteristic)return;
+      characteristic.addEventListener('characteristicvaluechanged',onNotify(kind));
+      if(typeof characteristic.startNotifications==='function')await characteristic.startNotifications();
+    }
+    async function write(characteristic,bytes){
+      if(typeof characteristic.writeValueWithResponse==='function')return characteristic.writeValueWithResponse(bytes);
+      return characteristic.writeValue(bytes);
+    }
+    function requireConnected(){
+      if(!state.connected||!chars.output||!chars.params)throw fail('NOT_CONNECTED','请先连接 R5 设备');
+    }
+
+    async function connect(){
+      if(!bluetooth||typeof bluetooth.requestDevice!=='function'){
+        const e=detectEnvironment(env);
+        if(e.androidWebView)throw fail('UNSUPPORTED','App 外壳（Android WebView）不支持网页蓝牙，需要原生蓝牙桥接；请先用安卓 Chrome 打开');
+        if(e.iOS)throw fail('UNSUPPORTED','iPhone 的浏览器不支持网页蓝牙，需要原生 App');
+        throw fail('UNSUPPORTED','当前浏览器不支持网页蓝牙，请用安卓 Chrome 在 HTTPS 下打开');
+      }
+      device=await bluetooth.requestDevice({filters:[{namePrefix:NAME_PREFIX}],optionalServices:[R5_SERVICE,BATTERY_SERVICE]});
+      if(!device?.gatt||typeof device.gatt.connect!=='function')throw fail('UNSUPPORTED','所选设备没有可用的 GATT 接口');
+      disconnectHandler=()=>{state.connected=false;chars={};pendingEcho=null;emit('disconnected');};
+      device.addEventListener?.('gattserverdisconnected',disconnectHandler);
+      const server=await device.gatt.connect();
+      let service;
+      try{service=await server.getPrimaryService(R5_SERVICE);}
+      catch(error){throw fail('UNSUPPORTED','设备上没有 R5 控制服务',error);}
+      chars.output=await service.getCharacteristic(R5_OUTPUT);
+      chars.params=await service.getCharacteristic(R5_PARAMS);
+      try{
+        const bat=await server.getPrimaryService(BATTERY_SERVICE);
+        chars.battery=await bat.getCharacteristic(BATTERY_LEVEL);
+      }catch(_){chars.battery=null;}
+      state.connected=true;state.deviceName=device.name||null;
+      await queue(async()=>{
+        state.output=decodeOutput(await chars.output.readValue());
+        state.params=decodeParams(await chars.params.readValue());
+        if(chars.battery)state.battery=decodeBattery(await chars.battery.readValue());
+        await subscribe(chars.output,'output');
+        await subscribe(chars.params,'params');
+        await subscribe(chars.battery,'battery');
+      });
+      emit('connected');
+      return snapshot();
+    }
+    function setOutput(code){
+      requireConnected();
+      const bytes=encodeOutput(code);
+      return queue(async()=>{const echo=pendingEcho={kind:'output',bytes,start:now(),armed:false};await write(chars.output,bytes);echo.armed=true;state.output=code;emit('written');return snapshot();});
+    }
+    function setParams(partial){
+      requireConnected();
+      const next={...state.params,...partial};
+      const bytes=encodeParams(next);
+      return queue(async()=>{const echo=pendingEcho={kind:'params',bytes,start:now(),armed:false};await write(chars.params,bytes);echo.armed=true;state.params=next;emit('written');return snapshot();});
+    }
+    function refresh(){
+      requireConnected();
+      return queue(async()=>{
+        state.output=decodeOutput(await chars.output.readValue());
+        state.params=decodeParams(await chars.params.readValue());
+        if(chars.battery)state.battery=decodeBattery(await chars.battery.readValue());
+        emit('refresh');return snapshot();
+      });
+    }
+    function disconnect(){
+      if(device?.gatt?.connected)device.gatt.disconnect();
+      else if(state.connected)disconnectHandler?.();
+    }
+    function subscribeState(fn){listeners.add(fn);return ()=>listeners.delete(fn);}
+    return {connect,setOutput,setParams,refresh,disconnect,subscribe:subscribeState,getState:snapshot};
+  }
+
+  return Object.freeze({R5_SERVICE,R5_OUTPUT,R5_PARAMS,BATTERY_SERVICE,BATTERY_LEVEL,NAME_PREFIX,OUTPUT_MODES,PARAM_KEYS,
+    R5DeviceError,decodeBattery,decodeOutput,encodeOutput,decodeParams,encodeParams,detectEnvironment,createClient});
+});
