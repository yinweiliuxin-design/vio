diff --git a/web-workspace/apps/international/dist/r5-device-page.js b/web-workspace/apps/international/dist/r5-device-page.js
new file mode 100644
index 0000000..0b7f546
--- /dev/null
+++ b/web-workspace/apps/international/dist/r5-device-page.js
@@ -0,0 +1,104 @@
+/* R5 device bring-up page: manual controls plus a scripted round-trip check. */
+(function(){
+  'use strict';
+  const R5=window.SVR5Device,$=id=>document.getElementById(id);
+  const env=R5.detectEnvironment(window);
+  const client=R5.createClient(window);
+  const LABELS={vol:'音量',tone:'音色',fx:'效果',mix:'伴奏比例'};
+  const record={page:'r5-device',startedAt:new Date().toISOString(),userAgent:navigator.userAgent,environment:env,device:null,results:[],roundTrips:[]};
+  const sliders={};let sending=null,running=false;
+
+  function log(text){const line=new Date().toLocaleTimeString()+'  '+text;$('log').textContent=line+'\n'+$('log').textContent;}
+  function mark(ok){return '<span class="'+(ok?'ok':'no')+'">'+(ok?'是':'否')+'</span>';}
+  $('env').innerHTML=[
+    ['安全连接（HTTPS 或本机）',mark(env.secureContext)],
+    ['浏览器支持网页蓝牙',mark(env.webBluetooth||env.nativeTransport)],
+    ['在 App 外壳（Android WebView）里',env.androidWebView?'<span class="no">是：外壳暂不支持蓝牙，请改用 Chrome</span>':'否'],
+    ['iPhone',env.iOS?'<span class="no">是：网页蓝牙不可用，需要原生 App</span>':'否']
+  ].map(([k,v])=>'<div class="row"><span>'+k+'</span><span>'+v+'</span></div>').join('');
+
+  for(const mode of R5.OUTPUT_MODES){
+    const b=document.createElement('button');b.textContent=mode.label;b.dataset.code=mode.code;b.disabled=true;b.setAttribute('aria-pressed','false');
+    b.addEventListener('click',()=>act(()=>client.setOutput(mode.code),'输出切到'+mode.label));
+    $('outputs').appendChild(b);
+  }
+  for(const key of R5.PARAM_KEYS){
+    const label=document.createElement('label');label.className='slider';
+    label.innerHTML='<span>'+LABELS[key]+'</span><input type="range" min="0" max="100" step="1" disabled><output>—</output>';
+    const input=label.querySelector('input'),out=label.querySelector('output');
+    input.addEventListener('input',()=>{out.textContent=input.value;queueParam(key,Number(input.value));});
+    sliders[key]={input,out};$('sliders').appendChild(label);
+  }
+  /* Coalesce slider drags: at most one write in flight, the latest value always sent. */
+  function queueParam(key,value){
+    const pending=sending||(sending={values:{},promise:null});pending.values[key]=value;
+    if(pending.promise)return;
+    pending.promise=(async()=>{
+      while(Object.keys(pending.values).length){const values=pending.values;pending.values={};
+        try{await client.setParams(values);}catch(e){log('写入失败：'+e.message);}}
+      sending=null;
+    })();
+  }
+  async function act(fn,what){try{await fn();log(what);}catch(e){log(what+' 失败：'+e.message);}}
+
+  function render(state){
+    $('name').textContent=state.connected?(state.deviceName||'已连接'):'未连接';
+    $('battery').textContent=state.battery==null?'—':state.battery+' %';
+    $('rtt').textContent=state.lastRoundTripMs==null?'—':state.lastRoundTripMs+' ms';
+    for(const b of $('outputs').children){b.disabled=!state.connected||running;b.setAttribute('aria-pressed',String(Number(b.dataset.code)===state.output));}
+    for(const key of R5.PARAM_KEYS){const s=sliders[key];s.input.disabled=!state.connected||running;
+      if(state.params&&document.activeElement!==s.input){s.input.value=state.params[key];s.out.textContent=state.params[key];}}
+    $('connect').disabled=state.connected;$('disconnect').disabled=!state.connected;$('refresh').disabled=!state.connected||running;
+    $('run').disabled=!state.connected||running;
+  }
+  client.subscribe((type,state)=>{
+    render(state);
+    if(type==='disconnected')log('设备已断开');
+    if(type==='roundtrip'&&running)record.roundTrips.push(state.lastRoundTripMs);
+  });
+  render(client.getState());
+
+  $('connect').addEventListener('click',async()=>{
+    try{const s=await client.connect();record.device=s.deviceName;log('已连接 '+(s.deviceName||''));render(s);}
+    catch(e){log('连接失败：'+e.message);}
+  });
+  $('disconnect').addEventListener('click',()=>client.disconnect());
+  $('refresh').addEventListener('click',()=>act(()=>client.refresh(),'重新读取'));
+
+  const wait=ms=>new Promise(r=>setTimeout(r,ms));
+  async function waitFor(check,timeout){const end=Date.now()+timeout;while(Date.now()<end){if(check(client.getState()))return true;await wait(20);}return false;}
+  function addResult(name,ok,detail){
+    record.results.push({name,ok,detail});
+    const row=document.createElement('tr');row.innerHTML='<td>'+name+'</td><td>'+(ok?'<span class="ok">通过</span>':'<span class="no">不通过</span>')+'</td><td>'+(detail||'')+'</td>';
+    $('results').appendChild(row);
+  }
+  async function step(name,fn,check,timeout=1500){
+    let echoed=false;const off=client.subscribe((type,s)=>{if(type==='roundtrip'&&check(s))echoed=true;});
+    const t0=performance.now();
+    try{await fn();}catch(e){off();addResult(name,false,e.message);return;}
+    const ok=await waitFor(()=>echoed,timeout);off();
+    addResult(name,ok,ok?Math.round(performance.now()-t0)+' ms':'超过 '+timeout+' ms 没收到设备回传');
+  }
+  $('run').addEventListener('click',async()=>{
+    running=true;$('results').innerHTML='';record.results=[];record.roundTrips=[];render(client.getState());
+    const original=client.getState();
+    for(const mode of R5.OUTPUT_MODES)await step('输出切到'+mode.label,()=>client.setOutput(mode.code),s=>s.output===mode.code);
+    for(const key of R5.PARAM_KEYS)for(const v of [0,100,50])await step(LABELS[key]+' = '+v,()=>client.setParams({[key]:v}),s=>s.params?.[key]===v);
+    const burstStart=performance.now();
+    await Promise.all([10,20,30,40,50,60,70,80,90].map(v=>client.setParams({vol:v})));
+    const burstOk=await waitFor(s=>s.params?.vol===90,1500);
+    addResult('连续拖动 9 次，最后一次生效',burstOk,Math.round(performance.now()-burstStart)+' ms');
+    try{await client.setOutput(original.output);await client.setParams(original.params);addResult('恢复原来的设置',true,'');}
+    catch(e){addResult('恢复原来的设置',false,e.message);}
+    const rt=record.roundTrips;
+    if(rt.length){const avg=Math.round(rt.reduce((a,b)=>a+b,0)/rt.length);addResult('往返时间统计',Math.max(...rt)<=1000,'平均 '+avg+' ms，最大 '+Math.max(...rt)+' ms（含固件 50 ms 合并通知）');}
+    record.finishedAt=new Date().toISOString();
+    running=false;render(client.getState());$('copy').disabled=false;
+    log('自动联调结束：'+record.results.filter(r=>r.ok).length+' / '+record.results.length+' 项通过');
+  });
+  $('copy').addEventListener('click',async()=>{
+    const text=JSON.stringify(record,null,2);
+    try{await navigator.clipboard.writeText(text);log('联调记录已复制，可粘贴发给开发方');}
+    catch(_){log('无法写入剪贴板，记录如下：\n'+text);}
+  });
+})();
