+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {readFile} from 'node:fs/promises';
+import vm from 'node:vm';
+
+const source=await readFile(new URL('../dist/r5-device.js',import.meta.url),'utf8');
+const context=vm.createContext({ArrayBuffer,Uint8Array,DataView,Promise,Date,setTimeout,clearTimeout});
+vm.runInContext(source,context,{filename:'r5-device.js'});
+const R5=context.SVR5Device;
+const wait=ms=>new Promise(resolve=>setTimeout(resolve,ms));
+
+function events(target={}){
+  const handlers=new Map();
+  target.addEventListener=(name,fn)=>{if(!handlers.has(name))handlers.set(name,new Set());handlers.get(name).add(fn);};
+  target.removeEventListener=(name,fn)=>handlers.get(name)?.delete(fn);
+  target.emit=name=>{for(const fn of [...(handlers.get(name)||[])])fn({target});};
+  return target;
+}
+
+/* Fake peripheral that follows the bench firmware rules in main/ble.c:
+ * output write must be 1 byte <= 3, params write must be 4 bytes each <= 100,
+ * any accepted write re-notifies output and params after ~50 ms. */
+function benchDevice({name='SmartVio-R5-bench',battery=87,withR5=true}={}){
+  const log=[];let busy=false;
+  const store={out:0,params:[70,50,60,50],battery};
+  const view=bytes=>new DataView(Uint8Array.from(bytes).buffer);
+  function characteristic(kind,read,writeRule){
+    const c=events({value:null,notifying:false,
+      async readValue(){guard();log.push('read:'+kind);this.value=view(read());return this.value;},
+      async startNotifications(){guard();this.notifying=true;log.push('notify:'+kind);return this;},
+      async writeValueWithResponse(data){
+        guard();const bytes=[...new Uint8Array(data.buffer,data.byteOffset,data.byteLength)];
+        if(!writeRule)throw Error('write not permitted');
+        writeRule(bytes);log.push('write:'+kind+':'+bytes.join(','));
+        setTimeout(()=>{for(const k of ['output','params']){const t=chars[k];if(t.notifying){t.value=view(k==='output'?[store.out]:store.params);t.emit('characteristicvaluechanged');}}},50);
+      }});
+    return c;
+  }
+  async function guard(){if(busy)throw Error('GATT operation already in progress');}
+  const chars={
+    output:characteristic('output',()=>[store.out],b=>{if(b.length!==1||b[0]>3)throw Error('invalid length');store.out=b[0];}),
+    params:characteristic('params',()=>store.params,b=>{if(b.length!==4||b.some(v=>v>100))throw Error('invalid length');store.params=b;}),
+    battery:characteristic('battery',()=>[store.battery],null)
+  };
+  const r5={async getCharacteristic(id){if(id===R5.R5_OUTPUT)return chars.output;if(id===R5.R5_PARAMS)return chars.params;throw Error('no characteristic');}};
+  const bas={async getCharacteristic(id){assert.equal(id,R5.BATTERY_LEVEL);return chars.battery;}};
+  const server={async getPrimaryService(id){if(id===R5.R5_SERVICE&&withR5)return r5;if(id===R5.BATTERY_SERVICE)return bas;throw Error('no service');}};
+  const device=events({name,gatt:{connected:false,async connect(){this.connected=true;return server;},disconnect(){this.connected=false;device.emit('gattserverdisconnected');}}});
+  const bluetooth={query:null,async requestDevice(query){this.query=query;return device;}};
+  return {bluetooth,device,store,chars,log,
+    setBattery(v){store.battery=v;chars.battery.value=view([v]);chars.battery.emit('characteristicvaluechanged');},
+    knobTurn(params){store.params=params;chars.params.value=view(params);chars.params.emit('characteristicvaluechanged');}};
+}
+
+test('UUIDs and formats match the R5 bench firmware GATT table',()=>{
+  assert.equal(R5.R5_SERVICE,'5a0e5000-7e4b-4c1e-9c2a-52355f425231');
+  assert.equal(R5.R5_OUTPUT,'5a0e5001-7e4b-4c1e-9c2a-52355f425231');
+  assert.equal(R5.R5_PARAMS,'5a0e5002-7e4b-4c1e-9c2a-52355f425231');
+  assert.equal(R5.BATTERY_SERVICE,0x180f);assert.equal(R5.BATTERY_LEVEL,0x2a19);
+  assert.deepEqual([...R5.encodeParams({vol:70,tone:50,fx:60,mix:50})],[70,50,60,50]);
+  assert.deepEqual({...R5.decodeParams(Uint8Array.of(1,2,3,100))},{vol:1,tone:2,fx:3,mix:100});
+  assert.deepEqual([...R5.encodeOutput(3)],[3]);
+  assert.throws(()=>R5.encodeOutput(4),/0–3/);
+  assert.throws(()=>R5.encodeParams({vol:101,tone:0,fx:0,mix:0}),/0–100/);
+  assert.throws(()=>R5.decodeParams(Uint8Array.of(1,2,3)),/4 字节/);
+  assert.throws(()=>R5.decodeBattery(Uint8Array.of(120)),/0–100/);
+});
+
+test('connect asks for the R5 service through optionalServices and reads the initial state',async()=>{
+  const fx=benchDevice(),client=R5.createClient({},{bluetooth:fx.bluetooth});
+  const s=await client.connect();
+  assert.deepEqual(JSON.parse(JSON.stringify(fx.bluetooth.query)),{filters:[{namePrefix:'SmartVio-R5'}],optionalServices:[R5.R5_SERVICE,0x180f]});
+  assert.equal(s.connected,true);assert.equal(s.deviceName,'SmartVio-R5-bench');
+  assert.equal(s.output,0);assert.deepEqual({...s.params},{vol:70,tone:50,fx:60,mix:50});assert.equal(s.battery,87);
+  assert.deepEqual(fx.log.filter(x=>x.startsWith('notify')),['notify:output','notify:params','notify:battery']);
+});
+
+test('output and parameter writes reach the device and the echo notification updates the round trip',async()=>{
+  let clock=1000;const fx=benchDevice(),client=R5.createClient({},{bluetooth:fx.bluetooth,now:()=>clock});
+  await client.connect();
+  await client.setOutput(1);assert.equal(fx.store.out,1);
+  clock+=63;await wait(80);
+  assert.equal(client.getState().lastRoundTripMs,63);
+  await client.setParams({vol:85});
+  assert.deepEqual(fx.store.params,[85,50,60,50],'unchanged parameters must be resent with their current values');
+  await wait(80);assert.deepEqual({...client.getState().params},{vol:85,tone:50,fx:60,mix:50});
+});
+
+test('rapid slider writes are serialised: no overlapping GATT operations and the last value wins',async()=>{
+  const fx=benchDevice(),client=R5.createClient({},{bluetooth:fx.bluetooth});
+  await client.connect();
+  let inFlight=0,maxInFlight=0;const original=fx.chars.params.writeValueWithResponse.bind(fx.chars.params);
+  fx.chars.params.writeValueWithResponse=async data=>{inFlight++;maxInFlight=Math.max(maxInFlight,inFlight);await wait(5);try{return await original(data);}finally{inFlight--;}};
+  await Promise.all([10,20,30,40,50].map(v=>client.setParams({vol:v})));
+  assert.equal(maxInFlight,1);assert.equal(fx.store.params[0],50);
+});
+
+test('changes made on the instrument (knob, battery) arrive as notifications',async()=>{
+  const fx=benchDevice(),client=R5.createClient({},{bluetooth:fx.bluetooth}),seen=[];
+  await client.connect();client.subscribe(type=>seen.push(type));
+  fx.knobTurn([40,55,60,20]);fx.setBattery(86);
+  assert.deepEqual({...client.getState().params},{vol:40,tone:55,fx:60,mix:20});
+  assert.equal(client.getState().battery,86);assert.deepEqual(seen,['params','battery']);
+});
+
+test('invalid values are refused before anything is sent',async()=>{
+  const fx=benchDevice(),client=R5.createClient({},{bluetooth:fx.bluetooth});
+  await client.connect();const before=fx.log.length;
+  assert.throws(()=>client.setOutput(7),/0–3/);
+  assert.throws(()=>client.setParams({mix:150}),/0–100/);
+  assert.equal(fx.log.length,before);
+});
+
+test('disconnect from the device side is reported and further writes are refused',async()=>{
+  const fx=benchDevice(),client=R5.createClient({},{bluetooth:fx.bluetooth}),seen=[];
+  await client.connect();client.subscribe(type=>seen.push(type));
+  fx.device.gatt.disconnect();
+  assert.equal(client.getState().connected,false);assert.deepEqual(seen,['disconnected']);
+  assert.throws(()=>client.setOutput(0),/请先连接/);
+});
+
+test('a device without the R5 service is rejected with a clear message',async()=>{
+  const fx=benchDevice({withR5:false}),client=R5.createClient({},{bluetooth:fx.bluetooth});
+  await assert.rejects(client.connect(),/没有 R5 控制服务/);
+});
+
+test('environment detection explains why the Android App shell and iPhone cannot connect yet',async()=>{
+  const webview={isSecureContext:true,navigator:{userAgent:'Mozilla/5.0 (Linux; Android 14; V2243A Build/UP1A; wv) AppleWebKit/537.36 (KHTML, like Gecko) Version/4.0 Chrome/129.0 Mobile Safari/537.36'}};
+  assert.equal(R5.detectEnvironment(webview).androidWebView,true);
+  await assert.rejects(R5.createClient(webview).connect(),/Android WebView/);
+  const iphone={isSecureContext:true,navigator:{userAgent:'Mozilla/5.0 (iPhone; CPU iPhone OS 18_0 like Mac OS X) AppleWebKit/605.1.15 Version/18.0 Mobile/15E148 Safari/604.1'}};
+  await assert.rejects(R5.createClient(iphone).connect(),/iPhone/);
+  const chrome={isSecureContext:true,navigator:{userAgent:'Mozilla/5.0 (Linux; Android 14) AppleWebKit/537.36 Chrome/129.0 Mobile Safari/537.36',bluetooth:{requestDevice(){}}}};
+  const env=R5.detectEnvironment(chrome);assert.equal(env.webBluetooth,true);assert.equal(env.androidWebView,false);
+});
+
+test('a native transport injected by the App shell is used when present',async()=>{
+  const fx=benchDevice(),client=R5.createClient({SilvioNativeBle:fx.bluetooth,navigator:{}});
+  const s=await client.connect();assert.equal(s.connected,true);
+});
+
+test('each accepted write produces exactly one roundtrip event from the device echo',async()=>{
+  const fx=benchDevice(),client=R5.createClient({},{bluetooth:fx.bluetooth}),seen=[];
+  await client.connect();client.subscribe(type=>seen.push(type));
+  await client.setParams({fx:30});await wait(80);
+  assert.equal(seen.filter(t=>t==='written').length,1);
+  assert.equal(seen.filter(t=>t==='roundtrip').length,1);
+  assert.deepEqual(seen.filter(t=>t==='output'||t==='params'),['output','params'],'firmware re-notifies both characteristics');
+});
+
+test('a re-notification left over from an earlier write is not mistaken for the echo of the next write',async()=>{
+  let clock=0;const fx=benchDevice(),client=R5.createClient({},{bluetooth:fx.bluetooth,now:()=>clock});
+  await client.connect();
+  await client.setOutput(2);            /* firmware will re-notify output and params in ~50 ms */
+  clock=100;await client.setParams({vol:33});
+  fx.chars.params.value=new DataView(Uint8Array.of(70,50,60,50).buffer);fx.chars.params.emit('characteristicvaluechanged');
+  assert.equal(client.getState().lastRoundTripMs,null,'stale params notification must not close the round trip');
+  clock=160;await wait(80);
+  assert.equal(client.getState().lastRoundTripMs,60);
+});
diff --git a/web-workspace/apps/mainland/dist/r5-device-page.js b/web-workspace/apps/mainland/dist/r5-device-page.js
new file mode 100644
index 0000000..0b7f546
--- /dev/null
+++ b/web-workspace/apps/mainland/dist/r5-device-page.js
@@ -0,0 +1,104 @@
+/* R5 device bring-up page: manual controls plus a scripted round-trip check. */
+(function(){
+  'use strict';
+  const R5=window.SVR5Device,$=id=>document.getElementById(id);
+  const env=R5.detectEnvironment(window);
+  const client=R5.createClient(window);
+  const LABELS={vol:'音量',tone:'音色',fx:'效果',mix:'伴奏比例'};
+  const record={page:'r5-device',startedAt:new Date().toISOString(),userAgent:navigator.userAgent,environment:env,device:null,results:[],roundTrips:[]};
+  const sliders={};let sending=null,running=false;
+
+  function log(text){const line=new Date().toLocaleTimeString()+'  '+text;$('log').textContent=line+'\n'+$('log').textContent;}
+  function mark(ok){return '<span class="'+(ok?'ok':'no')+'">'+(ok?'是':'否')+'</span>';}
+  $('env').innerHTML=[
+    ['安全连接（HTTPS 或本机）',mark(env.secureContext)],
+    ['浏览器支持网页蓝牙',mark(env.webBluetooth||env.nativeTransport)],
+    ['在 App 外壳（Android WebView）里',env.androidWebView?'<span class="no">是：外壳暂不支持蓝牙，请改用 Chrome</span>':'否'],
+    ['iPhone',env.iOS?'<span class="no">是：网页蓝牙不可用，需要原生 App</span>':'否']
+  ].map(([k,v])=>'<div class="row"><span>'+k+'</span><span>'+v+'</span></div>').join('');
+
+  for(const mode of R5.OUTPUT_MODES){
+    const b=document.createElement('button');b.textContent=mode.label;b.dataset.code=mode.code;b.disabled=true;b.setAttribute('aria-pressed','false');
+    b.addEventListener('click',()=>act(()=>client.setOutput(mode.code),'输出切到'+mode.label));
+    $('outputs').appendChild(b);
+  }
+  for(const key of R5.PARAM_KEYS){
+    const label=document.createElement('label');label.className='slider';
+    label.innerHTML='<span>'+LABELS[key]+'</span><input type="range" min="0" max="100" step="1" disabled><output>—</output>';
+    const input=label.querySelector('input'),out=label.querySelector('output');
+    input.addEventListener('input',()=>{out.textContent=input.value;queueParam(key,Number(input.value));});
+    sliders[key]={input,out};$('sliders').appendChild(label);
+  }
+  /* Coalesce slider drags: at most one write in flight, the latest value always sent. */
+  function queueParam(key,value){
+    const pending=sending||(sending={values:{},promise:null});pending.values[key]=value;
+    if(pending.promise)return;
+    pending.promise=(async()=>{
+      while(Object.keys(pending.values).length){const values=pending.values;pending.values={};
+        try{await client.setParams(values);}catch(e){log('写入失败：'+e.message);}}
+      sending=null;
+    })();
+  }
+  async function act(fn,what){try{await fn();log(what);}catch(e){log(what+' 失败：'+e.message);}}
+
+  function render(state){
+    $('name').textContent=state.connected?(state.deviceName||'已连接'):'未连接';
+    $('battery').textContent=state.battery==null?'—':state.battery+' %';
+    $('rtt').textContent=state.lastRoundTripMs==null?'—':state.lastRoundTripMs+' ms';
+    for(const b of $('outputs').children){b.disabled=!state.connected||running;b.setAttribute('aria-pressed',String(Number(b.dataset.code)===state.output));}
+    for(const key of R5.PARAM_KEYS){const s=sliders[key];s.input.disabled=!state.connected||running;
+      if(state.params&&document.activeElement!==s.input){s.input.value=state.params[key];s.out.textContent=state.params[key];}}
+    $('connect').disabled=state.connected;$('disconnect').disabled=!state.connected;$('refresh').disabled=!state.connected||running;
+    $('run').disabled=!state.connected||running;
+  }
+  client.subscribe((type,state)=>{
+    render(state);
+    if(type==='disconnected')log('设备已断开');
+    if(type==='roundtrip'&&running)record.roundTrips.push(state.lastRoundTripMs);
+  });
+  render(client.getState());
+
+  $('connect').addEventListener('click',async()=>{
+    try{const s=await client.connect();record.device=s.deviceName;log('已连接 '+(s.deviceName||''));render(s);}
+    catch(e){log('连接失败：'+e.message);}
+  });
+  $('disconnect').addEventListener('click',()=>client.disconnect());
+  $('refresh').addEventListener('click',()=>act(()=>client.refresh(),'重新读取'));
+
+  const wait=ms=>new Promise(r=>setTimeout(r,ms));
+  async function waitFor(check,timeout){const end=Date.now()+timeout;while(Date.now()<end){if(check(client.getState()))return true;await wait(20);}return false;}
+  function addResult(name,ok,detail){
+    record.results.push({name,ok,detail});
+    const row=document.createElement('tr');row.innerHTML='<td>'+name+'</td><td>'+(ok?'<span class="ok">通过</span>':'<span class="no">不通过</span>')+'</td><td>'+(detail||'')+'</td>';
+    $('results').appendChild(row);
+  }
+  async function step(name,fn,check,timeout=1500){
+    let echoed=false;const off=client.subscribe((type,s)=>{if(type==='roundtrip'&&check(s))echoed=true;});
+    const t0=performance.now();
+    try{await fn();}catch(e){off();addResult(name,false,e.message);return;}
+    const ok=await waitFor(()=>echoed,timeout);off();
+    addResult(name,ok,ok?Math.round(performance.now()-t0)+' ms':'超过 '+timeout+' ms 没收到设备回传');
+  }
+  $('run').addEventListener('click',async()=>{
+    running=true;$('results').innerHTML='';record.results=[];record.roundTrips=[];render(client.getState());
+    const original=client.getState();
+    for(const mode of R5.OUTPUT_MODES)await step('输出切到'+mode.label,()=>client.setOutput(mode.code),s=>s.output===mode.code);
+    for(const key of R5.PARAM_KEYS)for(const v of [0,100,50])await step(LABELS[key]+' = '+v,()=>client.setParams({[key]:v}),s=>s.params?.[key]===v);
+    const burstStart=performance.now();
+    await Promise.all([10,20,30,40,50,60,70,80,90].map(v=>client.setParams({vol:v})));
+    const burstOk=await waitFor(s=>s.params?.vol===90,1500);
+    addResult('连续拖动 9 次，最后一次生效',burstOk,Math.round(performance.now()-burstStart)+' ms');
+    try{await client.setOutput(original.output);await client.setParams(original.params);addResult('恢复原来的设置',true,'');}
+    catch(e){addResult('恢复原来的设置',false,e.message);}
+    const rt=record.roundTrips;
+    if(rt.length){const avg=Math.round(rt.reduce((a,b)=>a+b,0)/rt.length);addResult('往返时间统计',Math.max(...rt)<=1000,'平均 '+avg+' ms，最大 '+Math.max(...rt)+' ms（含固件 50 ms 合并通知）');}
+    record.finishedAt=new Date().toISOString();
+    running=false;render(client.getState());$('copy').disabled=false;
+    log('自动联调结束：'+record.results.filter(r=>r.ok).length+' / '+record.results.length+' 项通过');
+  });
+  $('copy').addEventListener('click',async()=>{
+    const text=JSON.stringify(record,null,2);
+    try{await navigator.clipboard.writeText(text);log('联调记录已复制，可粘贴发给开发方');}
+    catch(_){log('无法写入剪贴板，记录如下：\n'+text);}
+  });
+})();
diff --git a/web-workspace/apps/mainland/dist/r5-device.html b/web-workspace/apps/mainland/dist/r5-device.html
new file mode 100644
